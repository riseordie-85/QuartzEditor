<?xml version="1.0" encoding="utf-8"?>
<!-- ComfyUI has no https by default; the server address is yours (Tailscale encrypts the connection anyway) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
